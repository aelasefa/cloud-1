# ==============================================================================
# INCEPTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and set your custom values
# ==============================================================================

# User configuration (for host data path)
USER=ubuntu
DATA_PATH=/home/ubuntu/data

# Domain name
DOMAIN_NAME=yourdomain.duckdns.org

# MariaDB Configuration
MYSQL_HOST=mariadb
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
MYSQL_PASSWORD=YourSecurePassword123!
MYSQL_ROOT_PASSWORD=YourSecureRootPassword123!

# WordPress Configuration
WP_TITLE=Inception
WP_ADMIN_USER=admin_user
WP_ADMIN_PASS=AdminPassword123!
WP_ADMIN_EMAIL=admin@yourdomain.duckdns.org

# WordPress Additional User Configuration
WP_USER_USER=editor_user
WP_USER_PASS=EditorPassword123!
WP_USER_EMAIL=editor@yourdomain.duckdns.org

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=RedisPassword123!

# FTP Configuration
FTP_USER=ftpuser
FTP_PASS=FtpPassword123!
FTP_PASSWORD=FtpPassword123!
FTP_ROOT=/var/www/html
FTP_PORT=21
FTP_PASV_MIN_PORT=21100
FTP_PASV_MAX_PORT=21110

# Service Exposed Ports
NGINX_PORT=443
STATIC_SITE_PORT=8081
ADMINER_PORT=8082
PORTAINER_PORT=9001
